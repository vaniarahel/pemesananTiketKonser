@model List<PemesananTiketKonser.Models.Pembeli>
@{
    ViewData["Title"] = "Data Pembeli";
    string? cari = ViewBag.Cari;
    var no = 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Data Pembeli</h1>
    <a asp-action="Create" class="btn btn-primary">+ Tambah Pembeli</a>
</div>

@* Form cari: dikirim lewat GET, jadi hasilnya muncul di URL /Pembeli?cari=... *@
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="text" name="cari" value="@cari" class="form-control" placeholder="Cari nama, email, no HP, atau no identitas" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Cari</button>
        @if (!string.IsNullOrEmpty(cari))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        @(string.IsNullOrEmpty(cari) ? "Belum ada data pembeli." : $"Data tidak ditemukan untuk \"{cari}\".")
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(cari))
    {
        <p class="text-muted">Ditemukan @Model.Count pembeli untuk "@cari".</p>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>No</th>
                    <th>Nama</th>
                    <th>Email</th>
                    <th>No HP</th>
                    <th>No Identitas</th>
                    <th class="text-center">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@(no++)</td>
                        <td>@p.Nama</td>
                        <td>@p.Email</td>
                        <td>@p.NoHp</td>
                        <td>@p.NoIdentitas</td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Hapus</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
