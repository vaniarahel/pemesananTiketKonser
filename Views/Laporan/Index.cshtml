@model PemesananTiketKonser.Models.LaporanViewModel
@using PemesananTiketKonser.Helpers
@using PemesananTiketKonser.Models
@{
    ViewData["Title"] = "Laporan Penjualan";
    var no = 1;
    string periode = (Model.Dari, Model.Sampai) switch
    {
        (null, null) => "Semua tanggal",
        (DateTime d, null) => $"Sejak {d:dd/MM/yyyy}",
        (null, DateTime s) => $"Sampai {s:dd/MM/yyyy}",
        (DateTime d, DateTime s) => $"{d:dd/MM/yyyy} s.d. {s:dd/MM/yyyy}"
    };
}

<style>
    /* Saat dicetak: sembunyikan navbar, filter, dan tombol */
    @@media print {
        header, footer, .no-print { display: none !important; }
        .card { break-inside: avoid; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Laporan Penjualan</h1>
        <div class="text-muted">Periode: @periode · Status: @(Model.Status ?? "Semua")</div>
    </div>
    <button type="button" class="btn btn-outline-secondary no-print" onclick="window.print()">Cetak</button>
</div>

@* Filter laporan (dikirim lewat GET, jadi bisa di-bookmark) *@
<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4 no-print">
    <div class="col-sm-6 col-md-3">
        <label class="form-label" for="dari">Dari tanggal</label>
        <input type="date" id="dari" name="dari" value="@Model.Dari?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label" for="sampai">Sampai tanggal</label>
        <input type="date" id="sampai" name="sampai" value="@Model.Sampai?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label" for="status">Status</label>
        <select id="status" name="status" class="form-select">
            <option value="">Semua</option>
            <option value="@Pesanan.StatusLunas" selected="@(Model.Status == Pesanan.StatusLunas)">LUNAS</option>
            <option value="@Pesanan.StatusBelumLunas" selected="@(Model.Status == Pesanan.StatusBelumLunas)">BELUM LUNAS</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-3">
        <button type="submit" class="btn btn-primary">Tampilkan</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@* Ringkasan angka *@
<div class="row g-3 mb-4">
    <div class="col-6 col-lg">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Jumlah Pesanan</div>
            <div class="fs-4 fw-semibold">@Format.Angka(Model.TotalPesanan)</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Tiket Terjual</div>
            <div class="fs-4 fw-semibold">@Format.Angka(Model.TotalTiket)</div>
        </div></div>
    </div>
    <div class="col-12 col-sm-4 col-lg">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Nilai Penjualan</div>
            <div class="fs-5 fw-semibold">@Format.Rupiah(Model.NilaiPenjualan)</div>
        </div></div>
    </div>
    <div class="col-6 col-sm-4 col-lg">
        <div class="card h-100 border-success"><div class="card-body">
            <div class="text-muted small">Uang Masuk</div>
            <div class="fs-5 fw-semibold text-success">@Format.Rupiah(Model.UangMasuk)</div>
        </div></div>
    </div>
    <div class="col-6 col-sm-4 col-lg">
        <div class="card h-100 border-danger"><div class="card-body">
            <div class="text-muted small">Belum Dibayar</div>
            <div class="fs-5 fw-semibold text-danger">@Format.Rupiah(Model.Piutang)</div>
        </div></div>
    </div>
</div>

@if (Model.TotalPesanan == 0)
{
    <div class="alert alert-info">Tidak ada transaksi untuk filter ini.</div>
}
else
{
    <h2 class="h5">Ringkasan per Kategori</h2>
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Kategori</th>
                    <th class="text-end">Pesanan</th>
                    <th class="text-end">Tiket Terjual</th>
                    <th class="text-end">Nilai Penjualan</th>
                    <th class="text-end">Uang Masuk</th>
                    <th class="text-end">Belum Dibayar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model.PerKategori)
                {
                    <tr>
                        <td>@k.NamaKategori</td>
                        <td class="text-end">@Format.Angka(k.JumlahPesanan)</td>
                        <td class="text-end">@Format.Angka(k.TiketTerjual)</td>
                        <td class="text-end">@Format.Rupiah(k.NilaiPenjualan)</td>
                        <td class="text-end">@Format.Rupiah(k.UangMasuk)</td>
                        <td class="text-end">@Format.Rupiah(k.Piutang)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="fw-semibold table-light">
                <tr>
                    <td>Total</td>
                    <td class="text-end">@Format.Angka(Model.TotalPesanan)</td>
                    <td class="text-end">@Format.Angka(Model.TotalTiket)</td>
                    <td class="text-end">@Format.Rupiah(Model.NilaiPenjualan)</td>
                    <td class="text-end">@Format.Rupiah(Model.UangMasuk)</td>
                    <td class="text-end">@Format.Rupiah(Model.Piutang)</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <h2 class="h5">Rekap Transaksi</h2>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>No</th>
                    <th>ID Pesanan</th>
                    <th>Tanggal</th>
                    <th>Pembeli</th>
                    <th>Kategori</th>
                    <th class="text-end">Jumlah</th>
                    <th class="text-end">Total Harga</th>
                    <th class="text-end">Pembayaran</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Transaksi)
                {
                    <tr>
                        <td>@(no++)</td>
                        <td>@p.IdPesanan</td>
                        <td class="text-nowrap">@p.TglPesan.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@p.Pembeli?.Nama</td>
                        <td>@p.Kategori?.NamaKategori</td>
                        <td class="text-end">@p.JumlahTiket</td>
                        <td class="text-end text-nowrap">@Format.Rupiah(p.TotalHarga)</td>
                        <td class="text-end text-nowrap">@Format.Rupiah(p.Pembayaran)</td>
                        <td class="text-center">
                            @if (p.Status == Pesanan.StatusLunas)
                            {
                                <span class="badge bg-success">LUNAS</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">BELUM LUNAS</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="fw-semibold">
                <tr>
                    <td colspan="5">Total</td>
                    <td class="text-end">@Format.Angka(Model.TotalTiket)</td>
                    <td class="text-end text-nowrap">@Format.Rupiah(Model.NilaiPenjualan)</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <p class="text-muted small mt-2">
        Nilai penjualan = harga × jumlah tiket. Uang masuk tidak menghitung kelebihan bayar (kembalian).
        Belum dibayar = sisa tagihan pesanan yang BELUM LUNAS.
    </p>
}
