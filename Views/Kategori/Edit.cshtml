@model PemesananTiketKonser.Models.KategoriTiket
@{
    ViewData["Title"] = "Edit Kategori";
}

<h1 class="h3 mb-3">Edit Kategori Tiket</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
