@model List<PemesananTiketKonser.Models.KategoriDenganSisa>
@using PemesananTiketKonser.Helpers
@{
    ViewData["Title"] = "Kategori Tiket";
    var no = 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Kategori Tiket</h1>
    <a asp-action="Create" class="btn btn-primary">+ Tambah Kategori</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Belum ada kategori tiket.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>No</th>
                    <th>Nama Kategori</th>
                    <th class="text-end">Harga</th>
                    <th class="text-end">Kuota</th>
                    <th class="text-end">Terjual</th>
                    <th class="text-end">Sisa</th>
                    <th class="text-center">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(no++)</td>
                        <td>@item.Kategori.NamaKategori</td>
                        <td class="text-end">@Format.Rupiah(item.Kategori.Harga)</td>
                        <td class="text-end">@Format.Angka(item.Kategori.Kuota)</td>
                        <td class="text-end">@Format.Angka(item.Terjual)</td>
                        <td class="text-end">
                            @* Sisa kuota habis ditandai merah *@
                            @if (item.Sisa <= 0)
                            {
                                <span class="badge bg-danger">Habis</span>
                            }
                            else
                            {
                                @Format.Angka(item.Sisa)
                            }
                        </td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Kategori.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Kategori.Id" class="btn btn-sm btn-outline-danger">Hapus</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
