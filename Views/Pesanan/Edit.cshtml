@model PemesananTiketKonser.Models.Pesanan
@{
    ViewData["Title"] = "Edit Pesanan";
}

<h1 class="h3 mb-3">Edit Pesanan @Model.IdPesanan</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pesanan.js" asp-append-version="true"></script>
}