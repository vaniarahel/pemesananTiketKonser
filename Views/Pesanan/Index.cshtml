@model List<PemesananTiketKonser.Models.Pesanan>
@using PemesananTiketKonser.Helpers
@using PemesananTiketKonser.Models
@{
    ViewData["Title"] = "Pemesanan Tiket";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pemesanan Tiket</h1>
    <a asp-action="Create" class="btn btn-primary">+ Pesan Tiket</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Belum ada pesanan.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID Pesanan</th>
                    <th>Tanggal</th>
                    <th>Pembeli</th>
                    <th>Kategori</th>
                    <th class="text-end">Jumlah</th>
                    <th class="text-end">Total Harga</th>
                    <th class="text-end">Pembayaran</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@p.IdPesanan</td>
                        <td class="text-nowrap">@p.TglPesan.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@p.Pembeli?.Nama</td>
                        <td>@p.Kategori?.NamaKategori</td>
                        <td class="text-end">@p.JumlahTiket</td>
                        <td class="text-end text-nowrap">@Format.Rupiah(p.TotalHarga)</td>
                        <td class="text-end text-nowrap">@Format.Rupiah(p.Pembayaran)</td>
                        <td class="text-center">
                            @* Warna status ditentukan dengan Razor @if *@
                            @if (p.Status == Pesanan.StatusLunas)
                            {
                                <span class="badge bg-success">LUNAS</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">BELUM LUNAS</span>
                            }
                        </td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Hapus</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}