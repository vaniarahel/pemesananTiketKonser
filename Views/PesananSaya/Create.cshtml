@model PemesananTiketKonser.Models.PesanTiketViewModel
@using PemesananTiketKonser.Helpers
@using PemesananTiketKonser.Models
@{
    ViewData["Title"] = "Pesan Tiket";
    var pilihanKategori = (List<KategoriPilihan>)ViewBag.PilihanKategori;
    var kategoriTerpilih = pilihanKategori.FirstOrDefault(k => k.Id == Model.KategoriId);
}

<h1 class="h3 mb-3">Pesan Tiket</h1>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="KategoriId" class="form-label"></label>
                <select asp-for="KategoriId" class="form-select" id="KategoriId">
                    <option value="0" data-harga="0" data-sisa="0">-- Pilih kategori --</option>
                    @foreach (var k in pilihanKategori)
                    {
                        var habis = k.Sisa <= 0;
                        <option value="@k.Id" data-harga="@k.Harga" data-sisa="@k.Sisa" selected="@(k.Id == Model.KategoriId)" disabled="@habis">
                            @k.NamaKategori - @Format.Rupiah(k.Harga) (sisa @(habis ? "habis" : Format.Angka(k.Sisa)))
                        </option>
                    }
                </select>
                <span asp-validation-for="KategoriId" class="text-danger small"></span>
                <div class="form-text" id="infoKategori">
                    @if (kategoriTerpilih != null)
                    {
                        @:Harga satuan @Format.Rupiah(kategoriTerpilih.Harga), sisa kuota @Format.Angka(kategoriTerpilih.Sisa) tiket.
                    }
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="JumlahTiket" class="form-label"></label>
                    <input asp-for="JumlahTiket" type="number" min="1" max="@Pesanan.MaksTiketPerPesanan" class="form-control" />
                    <div class="form-text">Maksimal @Pesanan.MaksTiketPerPesanan tiket per pesanan.</div>
                    <span asp-validation-for="JumlahTiket" class="text-danger small"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label class="form-label">Total Harga</label>
                    <input type="text" id="totalHarga" class="form-control" readonly value="Dihitung otomatis" />
                </div>
            </div>

            <div class="alert alert-info small">
                Setelah pesanan dibuat, lakukan pembayaran di loket. Status pesanan akan berubah menjadi LUNAS setelah pembayaran dicatat admin.
            </div>

            <button type="submit" class="btn btn-primary">Pesan Sekarang</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Batal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pesanan.js" asp-append-version="true"></script>
}
