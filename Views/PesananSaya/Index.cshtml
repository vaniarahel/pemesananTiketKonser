@model List<PemesananTiketKonser.Models.Pesanan>
@using PemesananTiketKonser.Helpers
@using PemesananTiketKonser.Models
@{
    ViewData["Title"] = "Pesanan Saya";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pesanan Saya</h1>
    <a asp-action="Create" class="btn btn-primary">+ Pesan Tiket</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Kamu belum punya pesanan. <a asp-action="Create" class="alert-link">Pesan tiket sekarang</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID Pesanan</th>
                    <th>Tanggal</th>
                    <th>Kategori</th>
                    <th class="text-end">Jumlah</th>
                    <th class="text-end">Total Harga</th>
                    <th class="text-end">Sudah Dibayar</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@p.IdPesanan</td>
                        <td class="text-nowrap">@p.TglPesan.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@p.Kategori?.NamaKategori</td>
                        <td class="text-end">@p.JumlahTiket</td>
                        <td class="text-end text-nowrap">@Format.Rupiah(p.TotalHarga)</td>
                        <td class="text-end text-nowrap">
                            @Format.Rupiah(p.Pembayaran)
                            @if (p.Pembayaran < p.TotalHarga)
                            {
                                <div class="small text-danger">kurang @Format.Rupiah(p.TotalHarga - p.Pembayaran)</div>
                            }
                        </td>
                        <td class="text-center">
                            @if (p.Status == Pesanan.StatusLunas)
                            {
                                <span class="badge bg-success">LUNAS</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">BELUM LUNAS</span>
                            }
                        </td>
                        <td class="text-center">
                            @* Pesanan yang belum dibayar sama sekali boleh dibatalkan sendiri *@
                            @if (p.Pembayaran == 0)
                            {
                                <form asp-action="Batal" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Batalkan pesanan @p.IdPesanan?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Batalkan</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted small mt-2">
        Pembayaran dilakukan di loket. Status berubah menjadi LUNAS setelah pembayaran dicatat oleh admin.
    </p>
}
