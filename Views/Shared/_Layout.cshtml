@using Microsoft.AspNetCore.Http
@using PemesananTiketKonser.Helpers
@{
    // Nama controller yang sedang dibuka, untuk menandai menu yang aktif.
    var aktif = ViewContext.RouteData.Values["controller"]?.ToString();

    // Nama akun yang sedang login (null kalau belum login).
    var admin = Context.Session.GetString("Admin");

    // Admin melihat semua menu admin; Pembeli hanya melihat Pesan Tiket dan Pesanan Saya.
    var isAdmin = Context.IsAdmin();
    var isPembeli = Context.IsPembeli();
    var peran = Context.Peran();

    string Kelas(string controller) =>
        aktif == controller ? "nav-link text-dark fw-bold active" : "nav-link text-dark";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pemesanan Tiket Konser</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PemesananTiketKonser.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Tiket Konser</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Buka menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (isPembeli)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="@(aktif == "PesananSaya" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "nav-link text-dark fw-bold active" : "nav-link text-dark")" asp-controller="PesananSaya" asp-action="Create">Pesan Tiket</a>
                            </li>
                            <li class="nav-item">
                                <a class="@(aktif == "PesananSaya" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "nav-link text-dark fw-bold active" : "nav-link text-dark")" asp-controller="PesananSaya" asp-action="Index">Pesanan Saya</a>
                            </li>
                        </ul>
                    }

                    @if (isAdmin)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="@Kelas("Home")" asp-controller="Home" asp-action="Index">Menu Utama</a>
                            </li>
                            <li class="nav-item">
                                <a class="@Kelas("Pembeli")" asp-controller="Pembeli" asp-action="Index">Data Pembeli</a>
                            </li>
                            <li class="nav-item">
                                <a class="@Kelas("Kategori")" asp-controller="Kategori" asp-action="Index">Kategori Tiket</a>
                            </li>
                            <li class="nav-item">
                                <a class="@Kelas("Pesanan")" asp-controller="Pesanan" asp-action="Index">Pemesanan Tiket</a>
                            </li>
                            <li class="nav-item">
                                <a class="@Kelas("Laporan")" asp-controller="Laporan" asp-action="Index">Laporan Penjualan</a>
                            </li>
                        </ul>
                    }

                    @* Menu kanan: nama akun + Logout, untuk admin dan pembeli *@
                    @if (admin != null)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="nav-link text-muted">Halo, @admin (@peran)</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @* Pesan berhasil / gagal dari controller (TempData) *@
            @if (TempData["Sukses"] is string sukses)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @sukses
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
                </div>
            }
            @if (TempData["Gagal"] is string gagal)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @gagal
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Pemesanan Tiket Konser
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>